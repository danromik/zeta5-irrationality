delta_pos : ∀ (n : ℕ), 0 < evalZeta5 (Delta n)
'Zeta5.RealBound.eq_6_14' depends on axioms: [propext, Classical.choice, Quot.sound, Axioms.hermite_pole_integral]
'Zeta5.RealBound.prop_6_3' depends on axioms: [propext, Classical.choice, Quot.sound, Axioms.hermite_pole_integral]
'Zeta5.prop_6_3' depends on axioms: [propext, Classical.choice, Quot.sound, Axioms.hermite_pole_integral]
