 Axioms.hermite_pole_integral,
 Axioms.pnt_prime_riemann_sum]
'Zeta5.delta_pos' depends on axioms: [propext, Classical.choice, Quot.sound, Axioms.hermite_pole_integral]
RealBound.eq_6_14 : ∀ (n : ℕ),
  0 < n →
    0 < evalZeta5 (Delta n) →
      Real.log (evalZeta5 (Delta n)) ≤
        2 * ↑(h n) * (↑(h n) + 6 * ↑(N n) - ↑(K n)) * Real.log ↑(K n) +
              (↑lam * RealBound.M0 - RealBound.Irho) * ↑(K n) ^ 2 +
            18 * ↑(h n) * Real.log ↑(K n) +
          160 * ↑(h n)
prop_6_3 : ∀ (n : ℕ),
  0 < n → Real.log (evalZeta5 (F n)) ≤ ↑Ubar * ↑(K n) ^ 2 + 24 * ↑(K n) * Real.log ↑(K n) + 200 * ↑(K n)
def Zeta5.RealBound.Irho : ℝ :=
∑ j ∈ Finset.range 16, RealBound.wT j * Real.log ((RealBound.bT j - RealBound.aT j) / 4)
def Zeta5.RealBound.M0 : ℝ :=
-1329 / 200
def Zeta5.Ubar : ℚ :=
-2733991 / 2000000
def Zeta5.lam : ℚ :=
37 / 40
def Zeta5.Delta : ℕ → Polynomial ℚ :=
fun n => (G n).det
def Zeta5.F : ℕ → Polynomial ℚ :=
fun n => Polynomial.C (S n) * Delta n
Sec6.cauchy_cnd : ∀ (α β : MeasureTheory.Measure ℝ) [MeasureTheory.IsFiniteMeasure α] [MeasureTheory.IsFiniteMeasure β]
  {R : ℝ},
  (∀ᵐ (x : ℝ) ∂α, |x| ≤ R) →
    (∀ᵐ (x : ℝ) ∂β, |x| ≤ R) →
      α Set.univ = β Set.univ → ∀ {ε : ℝ}, 0 < ε → Sec6.kE ε α α - 2 * Sec6.kE ε α β + Sec6.kE ε β β ≤ 0
@Sec6.arcsine_pot : ∀ {a b : ℝ},
  a < b →
    ∀ (t : ℝ),
      IntervalIntegrable (fun θ => Real.log |t - ((a + b) / 2 + (b - a) / 2 * Real.cos θ)|) MeasureTheory.volume 0
          Real.pi ∧
        ∫ (θ : ℝ) in 0..Real.pi, Real.log |t - ((a + b) / 2 + (b - a) / 2 * Real.cos θ)| = Real.pi * Sec6.Uarc a b t
@Sec6.eq_6_6_cauchy : ∀ {m : ℕ} {K : ℝ},
  0 < K →
    ↑m = ↑lam * K →
      ∀ (t : Fin m → ℝ),
        Function.Injective t →
          ∀ {ε : ℝ},
            0 < ε →
              ↑m * Real.log ε + 2 * ∑ i, ∑ j > i, Real.log |t i - t j| ≤
                2 * K * ∑ i, Sec6.Urho (t i) - K ^ 2 * RealBound.Irho + 2 * K * ↑m * (88 * √ε + 420 * ε)
Sec6.configBound : ∀ (n : ℕ),
  0 < n →
    Sec6.ConfigBound n
      ((↑lam * RealBound.M0 - RealBound.Irho) * ↑(K n) ^ 2 + 2 * ↑(h n) * Real.log ↑(K n) + 20 * ↑(h n))
@Sec6.Gram.andreief : ∀ {α : Type u_1} [inst : MeasurableSpace α] (μ : MeasureTheory.Measure α)
  [MeasureTheory.SigmaFinite μ] {m : ℕ} (φ : Fin m → α → ℝ) (w : α → ℝ),
  (∀ (i j : Fin m), MeasureTheory.Integrable (fun x => φ i x * φ j x * w x) μ) →
    ↑m.factorial * (Matrix.of fun i j => ∫ (x : α), φ i x * φ j x * w x ∂μ).det =
      ∫ (x : Fin m → α), (Matrix.of fun i k => φ i (x k)).det ^ 2 * ∏ k, w (x k) ∂MeasureTheory.Measure.pi fun x => μ
Sec6.Gram.eq_6_10 : ∀ (n : ℕ),
  ↑(h n).factorial * evalZeta5 (Delta n) =
    ∫ (y : Fin (h n) → ℝ),
      (∏ i, ∏ j > i, (y j ^ 2 - y i ^ 2)) ^ 2 *
        ∏ k, Sec6.fW n (y k) ∂MeasureTheory.Measure.pi fun x => MeasureTheory.volume.restrict (Set.Ioi 0)
@Sec6.Num.cell_sound : ∀ {M l r : ℚ},
  Sec6.Num.cellOK M l r = true → ∀ {t : ℝ}, ↑l ≤ t → t ≤ ↑r → 2 * Sec6.Num.Uclosed t - Sec6.Num.Vclosed t ≤ ↑M
Sec6.Num.eq_6_7_closed : ∀ (K : ℝ),
  2 ≤ K → ∀ (t : ℝ), 0 ≤ t → 2 * Sec6.Num.Uclosed t - Sec6.Num.Vclosed t + √t / K ≤ -1329 / 200 + √2 / K
Sec6.rho_cross : ∀ (t : ℝ) {ε : ℝ}, 0 < ε → ∫ (y : ℝ), Sec6.kC ε (t - y) ∂Sec6.rhoM ≤ Sec6.Urho t + 88 * √ε + 420 * ε
Sec6.smooth_err_norm : ∀ (x : ℝ) {δ : ℝ},
  0 < δ →
    IntervalIntegrable (fun θ => Real.log (1 + δ ^ 2 / (x - Real.cos θ) ^ 2)) MeasureTheory.volume 0 Real.pi ∧
      ∫ (θ : ℝ) in 0..Real.pi, Real.log (1 + δ ^ 2 / (x - Real.cos θ) ^ 2) / 2 ≤ Real.pi * (δ + Real.pi * √(2 * δ))
@Sec6.rho_energy_ge : ∀ {ε : ℝ}, 0 < ε → RealBound.Irho ≤ Sec6.kE ε Sec6.rhoM Sec6.rhoM
@Sec6.Num.tail_bound_ge4 : ∀ {t K : ℝ},
  4 ≤ t → 2 ≤ K → 2 * Sec6.Num.Uclosed t - Sec6.Num.Vclosed t + √t / K ≤ -1329 / 200
RealBound.reg_const_le_sixty : ∑ j ∈ Finset.range 16,
    8 * RealBound.cT j * √2 / (Real.pi * √(RealBound.bT j - RealBound.aT j)) ≤
  60
Sec6.Gram.paper_6_9_admissible : ∀ (n : ℕ),
  0 < n →
    (↑lam * RealBound.M0 - RealBound.Irho) * ↑(K n) ^ 2 + (120 + √2) * ↑(h n) + 2 * ↑(h n) * Real.log ↑(K n) ≤
      (↑lam * RealBound.M0 - RealBound.Irho) * ↑(K n) ^ 2 + 3 * ↑(h n) * Real.log ↑(K n) + 131 * ↑(h n)
theorem Zeta5.prop_6_3 : ∀ (n : ℕ),
  0 < n → Real.log (evalZeta5 (F n)) ≤ ↑Ubar * ↑(K n) ^ 2 + 24 * ↑(K n) * Real.log ↑(K n) + 200 * ↑(K n) :=
fun n hn => RealBound.prop_6_3 n hn (delta_pos n)
direct users of Zeta5.Axioms.hermite_pole_integral: [Zeta5.Positivity.integral_wt_div_pole]
direct users of Zeta5.Axioms.pnt_prime_riemann_sum: [Zeta5.PrimeSum.tendsto_primeSum]
